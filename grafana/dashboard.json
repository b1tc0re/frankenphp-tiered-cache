        { "expr": "rate(franken_cache_l1_evictions_total[5m])", "legendFormat": "evictions/s", "refId": "B" },
        { "expr": "rate(franken_cache_l1_evicted_bytes_total[5m])", "legendFormat": "evicted bytes/s", "refId": "C" }
      ],
      "title": "L1 entries and pressure",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "decimals": 2, "mappings": [], "unit": "ms" }, "overrides": [] },
