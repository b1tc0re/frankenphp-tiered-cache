        { "expr": "rate(franken_cache_post_commit_errors_total[5m])", "legendFormat": "post-commit errors/s", "refId": "C" },
        { "expr": "rate(franken_cache_l1_mutation_errors_total[5m])", "legendFormat": "L1 mutation errors/s", "refId": "D" }
      ],
