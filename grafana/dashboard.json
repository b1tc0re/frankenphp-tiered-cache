        { "expr": "sum by (stage) (rate(franken_cache_invalidation_subscriber_errors_total[5m]))", "legendFormat": "subscriber {{stage}} errors", "refId": "B" }
      ],
      "title": "Pub/Sub activity",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "decimals": 2, "mappings": [], "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
