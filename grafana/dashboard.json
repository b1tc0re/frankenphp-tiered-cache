      "title": "Pub/Sub readiness",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "decimals": 1, "mappings": [], "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "100 * sum(rate(franken_cache_lookup_total{result=\"l1_hit\"}[5m])) / clamp_min(sum(rate(franken_cache_lookup_total[5m])), 1e-9)", "legendFormat": "L1 hit ratio", "refId": "A" }],
      "title": "L1 hit ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "decimals": 1, "mappings": [], "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (result) (rate(franken_cache_lookup_total[5m]))", "legendFormat": "{{result}}", "refId": "A" }],
      "title": "Lookup rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "decimals": 0, "mappings": [], "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "franken_cache_l1_bytes", "legendFormat": "used", "refId": "A" },
        { "expr": "franken_cache_l1_max_bytes", "legendFormat": "limit", "refId": "B" }
      ],
      "title": "L1 memory usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "decimals": 0, "mappings": [], "unit": "short" }, "overrides": [] },
